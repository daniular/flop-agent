# Salin file ini menjadi `.env` lalu isi nilainya. JANGAN commit `.env`.
# JANGAN taruh seed phrase / identity.pem / private key di file ini.
# Keystore yang dipakai di sini harus wallet KHUSUS devnet/testnet yang baru dibuat
# untuk testing (mis. via `flop --new-wallet`), BUKAN wallet yang menyimpan dana asli
# dan BUKAN identity.pem DID Technocore kamu.

# Jaringan: devnet | testnet (testnet BELUM live saat repo ini dibuat — lihat README)
FLOP_NETWORK=devnet

# Gateway HTTP (model list tidak butuh key; chat completion butuh key)
FLOP_GATEWAY_URL=https://api.flop.network/v1
# API key gateway — didapat dari `npm run enroll` (butuh keystore + tanda tangan wallet).
# Kosongkan kalau belum enroll; script chat akan menunjukkan error persisnya.
FLOP_API_KEY=

# Model default (daftar model: npm run health)
FLOP_MODEL=qwen/qwen2.5-0.5b-instruct
FLOP_PROMPT=Say hello.

# Alamat SS58 wallet FLOP kamu (untuk cek saldo + klaim faucet). BUKAN private key.
FLOP_SS58_ADDRESS=

# --- Bagian session on-chain (butuh keystore, BUKAN seed) ---
# Path ke file keystore JSON Polkadot (terenkripsi) + nama env var berisi passwordnya.
# Contoh: FLOP_KEYSTORE_PATH=/home/alex/.flop/agent-keystore.json
FLOP_KEYSTORE_PATH=
FLOP_KEY_PASSWORD_ENV=FLOP_KEY_PASSWORD
# FLOP_KEY_PASSWORD=  <-- isi di shell kamu sendiri, JANGAN tulis di file ini

# Miner untuk direct session (butuh alamat SS58 miner + endpoint-nya yang reachable).
# Tanpa ini, session.mjs berhenti setelah cek read-only dan menjelaskan yang kurang.
FLOP_MINER_ADDRESS=
FLOP_MINER_ENDPOINT=
# Escrow maksimum per session, dalam FLOP (default 0.01). Pilih dengan sadar.
FLOP_MAX_FLOP=0.01
# Batas spend session key turunan (default ikut CALIBRATED_LIMITS SDK: harian 50, per-tx 5)
FLOP_SESSION_DAILY_CAP=50
FLOP_SESSION_PER_TX=5
# Masa berlaku session key turunan, dalam jam (default 24)
FLOP_SESSION_EXPIRY_HOURS=24
